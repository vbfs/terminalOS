{
  "name": "terminalos",
  "version": "0.6.2",
  "description": "Browser-based terminal workspace built for AI-assisted development. Multi-pane layouts, live token tracking, integrated markdown editor, and 14 themes.",
  "bin": {
    "terminalos": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "build/",
    "runtime-dist/",
    "public/",
    "package.json"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"vite\" \"tsx server-pty.ts\"",
    "dev:web": "concurrently \"vite\" \"tsx server-pty.ts\"",
    "build:web": "vite build",
    "start:server": "tsx server-pty.ts",
    "build": "vite build",
    "build:runtime": "tsc -p runtime/tsconfig.json",
    "build:all": "npm run build && npm run build:runtime",
    "build:npx": "npm run build:web && npm run build:runtime && node scripts/obfuscate-runtime.mjs",
    "publish": "npm run build:npx && npm publish",
    "npx": "node bin/cli.js --start"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.0",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "javascript-obfuscator": "^5.4.1",
    "marked": "^17.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-window": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "express": "^4.21.0",
    "mammoth": "^1.12.0",
    "node-pty": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^10.0.0",
    "ws": "^8.20.0"
  }
}
